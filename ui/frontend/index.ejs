<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="A browser interface to the Rust compiler to experiment with the language" />
    <title><%= htmlRspackPlugin.options.title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  </head>
  <body>
    <main>
      <noscript>
        <p style="display:flex;justify-content: center;">The Rust Playground requires JavaScript to be enabled.</p>
      </noscript>
      <div id="playground"></div>
    </main>
  </body>
</html>
